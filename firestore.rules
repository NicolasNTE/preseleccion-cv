rules_version = '2';

// Solo los usuarios de RRHH autorizados pueden leer o escribir.
// Para autorizar a alguien: en Firestore crea un documento en la colección "autorizados"
// cuyo ID sea su correo en minúsculas (por ejemplo: autorizados/maria@innovandum.com).
service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/autorizados/$(request.auth.token.email.lower()));
    }

    // Cada usuario solo puede comprobar su propia autorización. Se administra desde la consola.
    match /autorizados/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    match /convocatorias/{convId} {
      allow read, write: if autorizado();

      match /candidatos/{candId} {
        allow read, write: if autorizado();
      }
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
